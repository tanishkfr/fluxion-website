# ---------------------------------------------------------------------------
# Fluxion Studios — environment
# Copy this file to .env.local for local development.
# In production, set the same keys in the Vercel project settings.
# Never commit real values.
# ---------------------------------------------------------------------------

# Required for the contact form to actually send email.
# Create a free account at https://resend.com using fluxion.workspace@gmail.com,
# then create an API key. Without this the form returns a clear "not configured"
# error and the UI falls back to the plain mailto link.
RESEND_API_KEY=

# The address enquiries are delivered to.
CONTACT_TO=fluxion.workspace@gmail.com

# The address enquiries are sent FROM.
# Until a custom domain is verified in Resend, leave this as the shared
# onboarding sender. Note: with the shared sender, Resend only delivers to the
# email address the Resend account was registered with — so register the
# account with CONTACT_TO above.
# Once a domain is verified, change this to e.g. "Fluxion Studios <hello@fluxion.studio>".
CONTACT_FROM=Fluxion Studios <onboarding@resend.dev>

# Canonical site origin, no trailing slash. Used for metadata, Open Graph,
# sitemap and robots. On Vercel this falls back to the deployment URL.
NEXT_PUBLIC_SITE_URL=
