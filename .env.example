# ---------------------------------------------------------------------------
# Fluxion Studios — environment
# Copy this file to .env.local for local development.
# In production, set the same keys in the Vercel project settings.
# Never commit real values.
# ---------------------------------------------------------------------------

# Required for the contact form to actually send email.
# Create a free account at https://resend.com using fluxion.workspace@gmail.com,
# then create an API key. Without this the form returns a clear "not configured"
# error and the UI falls back to the plain mailto link.
RESEND_API_KEY=

# The address enquiries are delivered to.
CONTACT_TO=fluxion.workspace@gmail.com

# The address enquiries are sent FROM.
# Until fluxionstudios.in is verified in Resend, leave this as the shared
# onboarding sender. Note: with the shared sender, Resend only delivers to the
# email address the Resend account was registered with — so register the
# account with CONTACT_TO above.
# Do NOT change this to the custom sender below until fluxionstudios.in has
# been separately verified in Resend; sending from an unverified domain fails.
# Once it is verified, change this to:
# "Fluxion Studios <hello@fluxionstudios.in>"
CONTACT_FROM=Fluxion Studios <onboarding@resend.dev>

# Canonical site origin, no trailing slash. Used for metadata, canonical tags,
# Open Graph, the sitemap and robots.
# Set this in the Vercel project to the real public domain:
#   NEXT_PUBLIC_SITE_URL=https://www.fluxionstudios.in
# Until it is set, Vercel deployments fall back to the deployment URL, and
# canonicals and the sitemap will point at that instead of the custom domain.
NEXT_PUBLIC_SITE_URL=https://www.fluxionstudios.in
